DATABASE_URL=postgresql://spendsmart:change-me@localhost:5432/spendsmart
SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=spendsmart-api
JWT_AUDIENCE=spendsmart-web

# Local development. Set REFRESH_COOKIE_SECURE=true in HTTPS production.
REFRESH_COOKIE_NAME=spendsmart_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_DOMAIN=
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
REDIS_URL=redis://localhost:6379/0
# Use "inline" on a single-process free deployment; local development keeps Celery.
OCR_EXECUTION_MODE=queue
RECEIPT_MAX_UPLOAD_BYTES=5242880
RECEIPT_MAX_PIXELS=20000000
OCR_TIMEOUT_SECONDS=30
TESSERACT_CMD=tesseract
